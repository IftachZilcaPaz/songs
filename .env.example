# Required: Claude API key for lyrics generation.
ANTHROPIC_API_KEY=

# Optional: override the lyrics model / thinking effort (low | medium | high | xhigh | max).
# ANTHROPIC_MODEL=claude-opus-5-5
# LYRICS_EFFORT=medium

# Optional: enables sung audio. Without it the app generates lyrics only.
ELEVENLABS_API_KEY=
# ELEVENLABS_MUSIC_MODEL=music_v2_5
# Upper bound for a full song, in seconds (Netlify functions stop after 60s of work).
# MUSIC_MAX_SONG_SECONDS=120

# Optional: when set, users must enter this code before generating (protects paid API usage).
APP_ACCESS_CODE=
